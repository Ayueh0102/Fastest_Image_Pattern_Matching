+// q28Sample()'s byte from 32-bit arithmetic where the rounding is clear. With the
+// weights cut to Q23 for x (each corner difference then moves the value by under 255
+// Q23 units) and one high multiply for y (under 2 more), the Q23 value is within 257
+// units of the exact one, so a value farther than that plus the guard from a rounding
+// boundary rounds like q28Sample() and needs neither its numerator nor its fallback.
+// margin = screenMargin(guard); interior pixels only, the rest go to q28Sample().
+__device__ __forceinline__ int screenMargin(u64 guard)
+{
+    const u64 units = guard >> 33; // Q56 to Q23, rounded up below
+    return 258 + (units < (1u << 23) ? int(units) : 1 << 23);
+}
+__device__ __forceinline__ u8 q28Sample32(const u8* s, int w, int h, long long sx, long long sy, int margin, u64 guard,
+    int x, int y, const DeviceWarp& exact, u8 border, unsigned& repaired)
+{
+    const int ix = int(sx >> 28), iy = int(sy >> 28);
+    if (unsigned(ix) < unsigned(w - 1) && unsigned(iy) < unsigned(h - 1)) {
+        const u8* p = s + size_t(iy) * w + ix;
+        const int p00 = p[0], p10 = p[1], p01 = p[w], p11 = p[w + 1];
+        const int dx = int((unsigned(sx) << 4) >> 9), dy = int((unsigned(sy) << 4) >> 1);
+        const int top = (p00 << 23) + (p10 - p00) * dx, bottom = (p01 << 23) + (p11 - p01) * dx;
+        const int value = top + 2 * __mulhi(bottom - top, dy);
+        const int fraction = value & ((1 << 23) - 1), distance = fraction > (1 << 22) ? fraction - (1 << 22) : (1 << 22) - fraction;
+        if (distance > margin) return u8((value + (1 << 22)) >> 23);
+    }
+    return q28Sample(s, w, h, sx, sy, guard, x, y, exact, border, repaired);
+}
